{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openai-image-mcp",
  "routes": [{ "pattern": "openai-image-mcp.agents.damao.io", "custom_domain": true }],
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "vars": { "IMAGE_MODEL": "gpt-image-2.5-sunburst" },
  "r2_buckets": [
    { "binding": "IMAGES_BUCKET", "bucket_name": "openai-image-mcp" }
  ],
  "images": { "binding": "IMAGES" },
  "durable_objects": {
    "bindings": [{ "name": "IMAGE_MCP", "class_name": "ImageMcp" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ImageMcp"] }],
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "51bbaf4537ec4e0fa06acf268e48ad75" }
  ]
}
